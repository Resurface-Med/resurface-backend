# Copy to .env.local for local development.
# In production these live in Vercel project settings, not in this repo.

# Which model writes the questions. Whichever key is set decides the provider,
# and Gemini wins when both are — so the cutover, and the way back, is an
# environment variable rather than a deploy.
#
# Server-side only. Holding these is the whole reason this service exists.
GEMINI_API_KEY=AIza...

# Optional. Defaults to gemini-3.5-flash-lite.
#
# On a free key the daily quota is what decides this, not the model's quality:
# every full Flash model is 20 requests/day, while Flash-Lite is 500/day and
# 15/minute. Flash-Lite is weaker at explaining why each wrong option is wrong,
# which is the visible cost of that choice.
#
# With billing enabled the quota stops mattering and gemini-3.7-flash is the
# better model. Roughly $0.02 a lecture.
# GEMINI_MODEL=gemini-3.7-flash

# Kept as the fallback. If GEMINI_API_KEY is absent this runs instead, so
# removing the Gemini key rolls generation back without shipping code.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase, used to verify the caller's session token. The anon/publishable key
# is enough to check a JWT; the service_role key is not needed and must not be
# put here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Comma-separated origins allowed to call this API from a browser.
# Without a match, responses carry no CORS headers and the browser blocks them.
ALLOWED_ORIGINS=http://localhost:5173,https://app.resurface.example
