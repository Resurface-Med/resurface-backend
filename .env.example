# Copy to .env.local for local development.
# In production these live in Vercel project settings, not in this repo.

# Anthropic key. Server-side only — this is the whole reason this service exists.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase, used to verify the caller's session token. The anon/publishable key
# is enough to check a JWT; the service_role key is not needed and must not be
# put here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Comma-separated origins allowed to call this API from a browser.
# Without a match, responses carry no CORS headers and the browser blocks them.
ALLOWED_ORIGINS=http://localhost:5173,https://app.resurface.example
